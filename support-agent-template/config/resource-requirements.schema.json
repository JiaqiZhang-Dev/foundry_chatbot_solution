{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.github.io/azure-sdk-tools/support-agent/resource-requirements.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provisioningModel",
    "resources",
    "outputBindings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "provisioningModel": {
      "const": "downstream"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "requiredBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "requiredBy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configuration": {
            "type": "object"
          },
          "source": {
            "type": "string"
          },
          "parameters": {
            "type": "string"
          },
          "containerPort": {
            "type": "integer"
          },
          "healthPath": {
            "type": "string"
          },
          "authentication": {
            "type": "string"
          },
          "authorization": {
            "type": "string"
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "azureResourceTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "access": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "principalOutput",
                "role"
              ],
              "properties": {
                "principalOutput": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "outputBindings": {
      "type": "object",
      "required": [
        "syntax",
        "consumers",
        "derivedOutputs"
      ],
      "properties": {
        "syntax": {
          "type": "string"
        },
        "consumers": {
          "type": "object"
        },
        "derivedOutputs": {
          "type": "object"
        }
      }
    }
  }
}
