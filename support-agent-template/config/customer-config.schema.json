{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.github.io/azure-sdk-tools/support-agent/customer-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "assistant"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "instructions",
        "model"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9000
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "default": "the configured business support domain"
        },
        "webSearch": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "contextSize": {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "medium"
            },
            "sourceHints": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string",
                "pattern": "^https://"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "autoReply": {
          "type": "boolean",
          "default": false
        },
        "teamId": {
          "type": "string",
          "minLength": 1
        },
        "channelIds": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "shortDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fullDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "locale": {
          "type": "string",
          "default": "en-US"
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        },
        "developer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "websiteUrl",
            "privacyUrl",
            "termsOfUseUrl"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "websiteUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "privacyUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "termsOfUseUrl": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "developer"
            ],
            "properties": {
              "developer": {}
            }
          }
        },
        {
          "if": {
            "required": [
              "autoReply"
            ],
            "properties": {
              "autoReply": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "enabled",
              "teamId",
              "channelIds"
            ],
            "properties": {
              "enabled": {
                "const": true
              },
              "teamId": {},
              "channelIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
