{
  "schemaVersion": "1.0",
  "template": "support-agent",
  "groups": [
    {
      "id": "solution",
      "label": "Solution"
    },
    {
      "id": "agent",
      "label": "Foundry hosted agent"
    },
    {
      "id": "teams",
      "label": "Microsoft Teams"
    },
    {
      "id": "autoReply",
      "label": "Channel auto-reply (Logic App)"
    }
  ],
  "parameters": [
    {
      "name": "solutionName",
      "group": "solution",
      "type": "string",
      "label": "Solution name",
      "description": "Lowercase identifier used for the generated solution.",
      "required": true,
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    {
      "name": "assistantDisplayName",
      "group": "agent",
      "type": "string",
      "label": "Assistant display name",
      "required": true,
      "maxLength": 100
    },
    {
      "name": "agentInstructions",
      "group": "agent",
      "type": "multiline-string",
      "label": "Agent instructions",
      "description": "Defines assistant behavior, boundaries, and response style.",
      "required": true,
      "maxLength": 9000
    },
    {
      "name": "modelDeployment",
      "group": "agent",
      "type": "model-deployment",
      "label": "Model deployment",
      "required": true
    },
    {
      "name": "assistantScope",
      "group": "agent",
      "type": "string",
      "label": "Support scope",
      "default": "the configured business support domain"
    },
    {
      "name": "webSearchEnabled",
      "group": "agent",
      "type": "boolean",
      "label": "Enable public web search",
      "default": true
    },
    {
      "name": "webSearchContextSize",
      "group": "agent",
      "type": "choice",
      "label": "Web search context size",
      "choices": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "visibleWhen": {
        "webSearchEnabled": true
      }
    },
    {
      "name": "knowledgeSources",
      "group": "agent",
      "type": "url-list",
      "label": "Preferred public sources",
      "default": [],
      "visibleWhen": {
        "webSearchEnabled": true
      }
    },
    {
      "name": "teamsEnabled",
      "group": "teams",
      "type": "boolean",
      "label": "Enable Microsoft Teams",
      "default": false
    },
    {
      "name": "teamsAutoReply",
      "group": "autoReply",
      "type": "boolean",
      "label": "Enable channel auto-reply",
      "default": false,
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "teamsTeamId",
      "group": "autoReply",
      "type": "string",
      "label": "Team ID",
      "requiredWhen": {
        "teamsAutoReply": true
      },
      "visibleWhen": {
        "teamsAutoReply": true
      }
    },
    {
      "name": "teamsChannelIds",
      "group": "autoReply",
      "type": "string-list",
      "label": "Channel IDs",
      "minItems": 1,
      "requiredWhen": {
        "teamsAutoReply": true
      },
      "visibleWhen": {
        "teamsAutoReply": true
      }
    },
    {
      "name": "teamsShortName",
      "group": "teams",
      "type": "string",
      "label": "Teams short name",
      "maxLength": 30,
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "teamsFullName",
      "group": "teams",
      "type": "string",
      "label": "Teams full name",
      "maxLength": 100,
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "teamsShortDescription",
      "group": "teams",
      "type": "string",
      "label": "Teams short description",
      "maxLength": 80,
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "teamsFullDescription",
      "group": "teams",
      "type": "multiline-string",
      "label": "Teams full description",
      "maxLength": 4000,
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "developerName",
      "group": "teams",
      "type": "string",
      "label": "Developer name",
      "requiredWhen": {
        "teamsEnabled": true
      },
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "developerWebsiteUrl",
      "group": "teams",
      "type": "url",
      "label": "Developer website",
      "requiredWhen": {
        "teamsEnabled": true
      },
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "privacyUrl",
      "group": "teams",
      "type": "url",
      "label": "Privacy URL",
      "requiredWhen": {
        "teamsEnabled": true
      },
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "termsOfUseUrl",
      "group": "teams",
      "type": "url",
      "label": "Terms of use URL",
      "requiredWhen": {
        "teamsEnabled": true
      },
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "locale",
      "group": "teams",
      "type": "string",
      "label": "Default locale",
      "default": "en-US",
      "visibleWhen": {
        "teamsEnabled": true
      }
    },
    {
      "name": "timezone",
      "group": "autoReply",
      "type": "string",
      "label": "Default timezone",
      "default": "UTC",
      "visibleWhen": {
        "teamsEnabled": true
      }
    }
  ]
}
