{
  "name": "@azure-sdk/support-agent-teams-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams frontend for the support-agent template",
  "type": "module",
  "main": "./lib/src/index.js",
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "dev:teamsfx:testtool": "cross-env IS_LOCAL=true BACKEND_BASE_URL=http://localhost:8000 npm run dev",
    "dev:teamsfx:launch-teams-testtool": "teamsapptester start",
    "start": "node lib/src/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.9.1",
    "botbuilder": "^4.23.1",
    "express": "^5.2.0"
  },
  "devDependencies": {
    "@microsoft/teams-app-test-tool": "^0.2.20",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@microsoft/recognizers-text": "^1.3.1",
    "@microsoft/recognizers-text-choice": "^1.3.1",
    "@microsoft/recognizers-text-date-time": "^1.3.1",
    "@microsoft/recognizers-text-number": "^1.3.1",
    "@microsoft/recognizers-text-number-with-unit": "^1.3.1",
    "@microsoft/recognizers-text-sequence": "^1.3.1",
    "@microsoft/recognizers-text-suite": "^1.3.1",
    "uuid": ">=11.1.1"
  }
}
