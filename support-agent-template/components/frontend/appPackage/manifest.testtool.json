{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "0.1.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Local developer",
    "websiteUrl": "https://localhost",
    "privacyUrl": "https://localhost/privacy",
    "termsOfUseUrl": "https://localhost/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Support Agent",
    "full": "Support Agent (local)"
  },
  "description": {
    "short": "Local support agent test application",
    "full": "Run and test the support agent locally in Microsoft 365 Agents Playground."
  },
  "accentColor": "#2563EB",
  "bots": [
    {
      "botId": "${{TEAMS_APP_ID}}",
      "scopes": [
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": []
    }
  ],
  "composeExtensions": [],
  "configurableTabs": [],
  "staticTabs": [],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
