{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "0.1.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "${{DEVELOPER_NAME}}",
    "websiteUrl": "${{DEVELOPER_WEBSITE_URL}}",
    "privacyUrl": "${{PRIVACY_URL}}",
    "termsOfUseUrl": "${{TERMS_OF_USE_URL}}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "${{TEAMS_BOT_SHORT_DISPLAY_NAME}}",
    "full": "${{TEAMS_BOT_FULL_DISPLAY_NAME}}"
  },
  "description": {
    "short": "${{TEAMS_APP_SHORT_DESCRIPTION}}",
    "full": "${{TEAMS_APP_FULL_DESCRIPTION}}"
  },
  "accentColor": "#2563EB",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": [
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": []
    }
  ],
  "composeExtensions": [],
  "configurableTabs": [],
  "staticTabs": [],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
